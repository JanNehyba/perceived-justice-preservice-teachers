// Figure 6.1 (CZ) — vývoj sebehodnoticího nástroje (dvě pilotní verze a tři další verze).
// Revize 8. 10. 2026 (B6-293 „nečitelný, moc informací v buňkách"; D3 pilotní verze 1–2):
// svislé uspořádání, větší písmo, v rámečcích jen počet položek, osoba a škála.
// Velikosti vzorků jsou v tab. 4.1 a v textu (manifesty), do obrázku se nepíšou.
digraph evolution {
  rankdir=TB;
  bgcolor="white";
  node [fontname="Arial", fontsize=15, shape=box, style="rounded,filled", penwidth=1.4, margin="0.30,0.14", width=4.6];
  edge [fontname="Arial", fontsize=13, color="#6E6E6E", fontcolor="black", arrowsize=0.9, penwidth=1.3];
  graph [ranksep=0.42, nodesep=0.3];

  V1 [label="Pilotní verze 1 (2019)\n21 položek · 3. osoba · popis jednání", fillcolor="#F4F4F4", fontcolor="#555555", color="#B8B8B8", style="rounded,filled,dashed"];
  V2 [label="Pilotní verze 2 (2020)\n23 položek · 3. osoba · normy „učitel by měl“", fillcolor="#F4F4F4", fontcolor="#333333", color="#9A9A9A", style="rounded,filled,dashed"];
  V3 [label="Verze 3 (2021)\nzásobník 36 položek · 1. osoba · škála souhlasu", fillcolor="#FFD9B8", color="#FF7300"];
  V4 [label="Verze 4 (2022)\n26 položek · 1. osoba · škála souhlasu", fillcolor="#FFD9B8", color="#FF7300"];
  V5 [label="Verze 5 (2023–2026) · finální nástroj\n26 položek · 1. osoba · škála spravedlnosti", fillcolor="#0000DC", fontcolor="white", color="#0000DC", penwidth=2.2];

  V1 -> V2 [label="  popis → normy"];
  V2 -> V3 [label="  3. osoba → 1. osoba, širší zásobník"];
  V3 -> V4 [label="  výběr 26 položek"];
  V4 -> V5 [label="  nová škála; 2 položky přeformulovány", color="#F01928", fontcolor="#F01928", penwidth=2];
}
